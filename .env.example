# ==============================================================================
# ConnectSphere Environment Configuration Template
# Copy this file to '.env' for local configuration.
# NEVER commit real production secrets, API tokens, or credentials into Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
# Set to 'False' in production. When False, unhandled errors render branded 500 pages
# without revealing tracebacks or configuration secrets.
DJANGO_DEBUG=True

# Mandatory in production when DJANGO_DEBUG=False.
# Generate a cryptographically secure 50+ character random key.
# Example: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-this-to-a-very-secure-random-key-in-production

# Comma-separated list of hostnames/domains this Django site can serve.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,connectsphere.example.com

# Comma-separated list of trusted origins for unsafe requests (POST, PUT).
DJANGO_CSRF_TRUSTED_ORIGINS=https://connectsphere.example.com

# ------------------------------------------------------------------------------
# DATABASE SETTINGS
# ------------------------------------------------------------------------------
# In production, specify a PostgreSQL connection string.
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>
# Leave blank or commented out in local development to default to SQLite (db.sqlite3).
# DATABASE_URL=postgres://connectsphere_user:secret_password@localhost:5432/connectsphere_prod

# ------------------------------------------------------------------------------
# SECURITY & SSL SETTINGS (Active when DJANGO_DEBUG=False)
# ------------------------------------------------------------------------------
# Redirect all HTTP requests to HTTPS (default True in production).
# Set to 'False' if TLS/SSL is terminated upstream at a reverse-proxy/load-balancer.
DJANGO_SECURE_SSL_REDIRECT=True

# HTTP Strict Transport Security (HSTS) duration in seconds (default 31536000 = 1 year).
DJANGO_SECURE_HSTS_SECONDS=31536000

# ------------------------------------------------------------------------------
# GUNICORN APPLICATION SERVER (Production WSGI)
# ------------------------------------------------------------------------------
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=30
GUNICORN_LOG_LEVEL=info
